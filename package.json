{
  "name": "dreamhomes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5180",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build && node --import tsx scripts/prerender.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --project tsconfig.functions.json",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "verify-build": "node --import tsx scripts/verify-build.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "gsap": "^3.13.0",
    "@gsap/react": "^2.1.2",
    "lenis": "^1.3.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^6.4.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0"
  }
}
